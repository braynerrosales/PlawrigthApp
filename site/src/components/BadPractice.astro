---
/** Antipatrón a evitar. Con `id` muestra el snippet (código real que hoy funciona pero es frágil). */
import CodeExample from './CodeExample.astro';

interface Props {
	title?: string;
	id?: string;
}

const { title, id } = Astro.props;
const heading = title && title[0]!.toUpperCase() + title.slice(1);
---

<aside class="practice practice--bad" aria-label={`Evitar${title ? `: ${title}` : ''}`}>
	<p class="practice__label"><span aria-hidden="true">✕</span> Evitar{heading && <span class="practice__title">{heading}</span>}</p>
	{id && <CodeExample id={id} bare />}
	<div class="practice__body"><slot /></div>
</aside>
