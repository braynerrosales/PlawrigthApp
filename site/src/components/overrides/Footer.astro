---
/** Añade el control de progreso al final de cualquier página que sea un módulo y el crédito del sitio. */
import Default from '@astrojs/starlight/components/Footer.astro';
import Progress from '../Progress.astro';
import { getModule } from '../../lib/modules';

const { entry } = Astro.locals.starlightRoute;
const module = getModule(entry.data);

// Invasor pixelado (el 👾) como SVG: un emoji no se puede recolorear de forma fiable.
const INVADER = [
	'..X.....X..',
	'...X...X...',
	'..XXXXXXX..',
	'.XX.XXX.XX.',
	'XXXXXXXXXXX',
	'X.XXXXXXX.X',
	'X.X.....X.X',
	'...XX.XX...',
];
const invaderPath = INVADER.flatMap((row, y) =>
	[...row].flatMap((cell, x) => (cell === 'X' ? [`M${x} ${y}h1v1h-1z`] : [])),
).join('');
---

{
	module && (
		<div class="module-end">
			<p>¿Terminaste el módulo?</p>
			<Progress module={entry.id} />
		</div>
	)
}
<Default />
<p class="credit">
	Made by
	<svg class="invader invader--me" viewBox="0 0 11 8" aria-hidden="true"><path d={invaderPath} /></svg>
	Ing. Brayner Rosales Solís x
	<svg class="invader invader--claude" viewBox="0 0 11 8" aria-hidden="true"><path d={invaderPath} /></svg>
	Claude
</p>

<style>
	.module-end {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 3rem;
		padding: 1rem 0;
		border-top: 1px solid var(--pg-border);
	}
	.module-end p {
		margin: 0;
		color: var(--sl-color-gray-3);
	}
	.credit {
		margin: 2rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--pg-border);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.invader {
		width: 1.1em;
		height: 0.8em;
		vertical-align: -0.05em;
		margin-inline: 0.3em;
		shape-rendering: crispEdges;
	}
	.invader--me {
		fill: var(--sl-color-accent);
	}
	.invader--claude {
		fill: var(--pg-claude);
	}
</style>
